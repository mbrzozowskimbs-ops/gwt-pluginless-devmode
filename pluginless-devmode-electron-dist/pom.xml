<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cloud.rubibubi.gwt.pluginless</groupId>
        <artifactId>gwt-pluginless-devmode</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>pluginless-devmode-electron-dist</artifactId>
    <!-- Versioned like Electron, not like Pluginless DevMode: one release per Electron build -->
    <version>45.0.0</version>
    <packaging>pom</packaging>
    <name>pluginless-devmode-electron-dist</name>
    <description>Official Electron builds repackaged as jars, one per platform (classifier), for the Pluginless DevMode debug
        browser: META-INF/pluginless-devmode/electron.zip and electron.properties</description>

    <properties>
        <electron.version>${project.version}</electron.version>
        <!-- Release downloads; may point to a mirror with the same layout -->
        <electron.mirror>https://github.com/electron/electron/releases/download/v${electron.version}</electron.mirror>
        <dist.directory>${project.build.directory}/dist</dist.directory>
    </properties>

    <build>
        <plugins>
            <!-- Cached in the local repository (.cache/download-maven-plugin), so only the first build downloads -->
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <configuration>
                    <outputFileName>electron.zip</outputFileName>
                </configuration>
                <executions>
                    <!-- sha256 from SHASUMS256.txt of the Electron release -->
                    <execution>
                        <id>darwin-arm64</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <uri>${electron.mirror}/electron-v${electron.version}-darwin-arm64.zip</uri>
                            <outputDirectory>${dist.directory}/darwin-arm64/META-INF/pluginless-devmode</outputDirectory>
                            <sha256>896c3a50b148e89a158dca08a6996a022ddf39b23aac871e107f5b4087f8caa9</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <id>darwin-x64</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <uri>${electron.mirror}/electron-v${electron.version}-darwin-x64.zip</uri>
                            <outputDirectory>${dist.directory}/darwin-x64/META-INF/pluginless-devmode</outputDirectory>
                            <sha256>7877c282e74a52f8d87949536a25735cf9982de1265b544c9cd258dd14eff4de</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <id>linux-x64</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <uri>${electron.mirror}/electron-v${electron.version}-linux-x64.zip</uri>
                            <outputDirectory>${dist.directory}/linux-x64/META-INF/pluginless-devmode</outputDirectory>
                            <sha256>22f6a10bd3f7fef987ddbb379d3375ce664ad0c98a9a50f80c89f1718a0c3e3a</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <id>win32-x64</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <uri>${electron.mirror}/electron-v${electron.version}-win32-x64.zip</uri>
                            <outputDirectory>${dist.directory}/win32-x64/META-INF/pluginless-devmode</outputDirectory>
                            <sha256>ae53887a23bb640369c93dbd38c408a2af5c0deb86f2fa76c6c244cb444b7f47</sha256>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>electron-properties</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${dist.directory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/dist</directory>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>darwin-arm64</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>darwin-arm64</classifier>
                            <classesDirectory>${dist.directory}/darwin-arm64</classesDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>darwin-x64</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>darwin-x64</classifier>
                            <classesDirectory>${dist.directory}/darwin-x64</classesDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>linux-x64</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>linux-x64</classifier>
                            <classesDirectory>${dist.directory}/linux-x64</classesDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>win32-x64</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>win32-x64</classifier>
                            <classesDirectory>${dist.directory}/win32-x64</classesDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
