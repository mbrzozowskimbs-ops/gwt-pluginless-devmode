<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cloud.rubibubi.gwt.pluginless</groupId>
        <artifactId>gwt-pluginless-devmode</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pluginless-devmode-electron</artifactId>
    <packaging>pom</packaging>
    <name>pluginless-devmode-electron</name>
    <description>Debug browser for Pluginless DevMode: Chromium (Electron) with a synchronous IPC channel to the bridge</description>

    <properties>
        <!-- Downloads Node.js and Electron during the build; skip with -Dskip.electron=true -->
        <skip.electron>false</skip.electron>
        <!-- Page opened by mvn -pl pluginless-devmode-electron frontend:npm@start; the default is pluginless-devmode-sample -->
        <pluginless.url>http://localhost:8888/sample/Sample.html?gwt.codesvr=127.0.0.1:9876</pluginless.url>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>install-node</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <skip>${skip.electron}</skip>
                        </configuration>
                    </execution>
                    <!-- The electron package downloads the Chromium build for the current platform -->
                    <execution>
                        <id>npm-install</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <skip>${skip.electron}</skip>
                            <arguments>install --no-audit --no-fund</arguments>
                        </configuration>
                    </execution>
                    <!-- mvn -pl pluginless-devmode-electron frontend:npm@start [-Dpluginless.url=...]: the browser without
                         PluginlessDevMode, which starts it itself with -Dpluginless.electron -->
                    <execution>
                        <id>start</id>
                        <phase>none</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>start -- ${pluginless.url}</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
